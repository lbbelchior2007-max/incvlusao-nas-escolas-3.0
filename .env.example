# Copie para .env e preencha localmente. Nunca publique o arquivo .env.
PORT=3333
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/inclusao_escolar
JWT_SECRET=COLOQUE_UM_SEGREDO_LONGO_E_ALEATORIO_AQUI
# Usados somente no primeiro cadastro do proprietário, via npm run owner:create
OWNER_NAME=Proprietario da Plataforma
OWNER_EMAIL=seu-email-real@exemplo.com
OWNER_PASSWORD=DefinaUmaSenhaForteAqui
